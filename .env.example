# =============================================================
#  IA Imperial Bonés — variáveis de ambiente
#  Copie para .env e preencha. A config é validada no boot
#  (src/main/config.js) — valores inválidos derrubam o start.
# =============================================================

# OBRIGATÓRIA — a IA não funciona sem ela
OPENAI_API_KEY=sk-...

# ChatClean Push API: URL autenticada gerada em Configurações → API/Webhook →
# Adicionar. O token JWT já vem embutido como ?token=... (não precisa header).
CC_PUSH_URL=

# URL pública deste servidor (sem barra final) — serve as imagens em /assets
BASE_URL=

# Ambiente. Com NODE_ENV=production a config exige WEBHOOK_SECRET (>=16 chars)
# e CC_PUSH_URL — o boot falha se faltarem (fail-closed).
NODE_ENV=development

# Token para validar as requisições do webhook de entrada
# (header x-webhook-token ou Authorization: Bearer ...). OBRIGATÓRIO em produção.
WEBHOOK_SECRET=

# Chave das rotas administrativas (/analytics). Sem ela a rota responde 503.
# Uso: GET /analytics com header x-admin-key: <chave> (ou ?key=<chave>)
ADMIN_KEY=

# Teto de mensagens por minuto por contato (contém custo de OpenAI em loop/abuso)
RATE_LIMIT_POR_CONTATO=20

# WhatsApp interno que recebe o resumo dos leads qualificados (opcional:
# sem ele o resumo vai só como nota interna no ticket)
EQUIPE_NUMERO=

# Fase de teste: números permitidos, separados por vírgula (vazio = todos).
# Tolerante ao 9º dígito (5584994610845 e 558494610845 casam).
IA_ALLOWED_CONTACTS=

# Porta do servidor
PORT=3000

# Núcleo da IA: false = fluxo legado (state machine), true = agente com
# tool-calling (Fase 3). Valide pelos evals antes de ligar em produção.
AGENT_MODE=false

# Modelo do agente (gpt-4o-mini é instável nas ferramentas terminais)
AGENT_MODEL=gpt-4o

# Prévia da logo aplicada (gpt-image-1). Qualquer valor != false liga.
MOCKUP_ENABLED=true

# Loga o payload cru do webhook (contém PII — ligue só para depurar)
LOG_PAYLOAD=false

# Estado das conversas: Redis persistente (recomendado em produção).
# Vazio = memória (perde no restart). Ex.: redis://:senha@host:6379
REDIS_URL=
REDIS_PREFIX=imperialbones
